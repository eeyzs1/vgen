        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "schedule",
        0
      ],
      "latent_image": [
        "prepare",
        1
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
