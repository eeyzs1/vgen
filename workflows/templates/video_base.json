      "denoise": 1.0
    }
  },
  "first": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "FIRST.png"
    }
  },
  "prepare": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "prompt": "PROMPT",
