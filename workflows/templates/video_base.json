      "height": 768,
      "length": 124,
      "first_frame": [
        "first",
        0
      ]
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "conditioning": [
        "prepare",
        0
      ]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
